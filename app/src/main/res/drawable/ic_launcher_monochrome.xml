<?xml version="1.0" encoding="utf-8"?>
<!--
    单色层（Android 13+ 主题图标用的剪影）。

    主题图标只取形状、颜色由系统按壁纸调色板生成，所以这里只画一枚 E：
    用**描边折线**（圆头圆角）而不是填色路径，笔画才和新图标上那枚圆润的 E 一致。

    画布 108×108 是规范尺寸，系统只显示中间 72×72（x/y 各 18–90），
    这枚 E 连同笔画外沿落在 x 43–66、y 36–71，正好收在中间。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M47,40 V67 M47,40 H62 M47,53.5 H60 M47,67 H62"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
