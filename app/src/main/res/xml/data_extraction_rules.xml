<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 起 allowBackup 已废弃，改由 dataExtractionRules 声明备份与换机迁移的范围。
    这里显式排除全部数据，与 allowBackup="false" 保持一致：
    学习进度只存在本机，卸载即随之清除，不进云备份、也不随换机迁移。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
